<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0</AssemblyVersion>
		<FileVersion>1.0.0</FileVersion>
		<RollForward>Major</RollForward>
		<PublishReadyToRun Condition="'$(PublishSingleFile)' == 'true' and '$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="../SeederFramework/SeederFramework.csproj" />
		<ProjectReference Include="../SeederFoundations/SeederFoundations.csproj" />
		<ProjectReference Include="../MudSharpCore/MudSharpCore.csproj" Aliases="EngineCompiler" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.15" />
		<EmbeddedResource Include="Assets/Manifests/Armageddon_Reviewed_Content.json" LogicalName="ArmageddonReviewedContentManifest" />
		<EmbeddedResource Include="../Design Documents/Magic/Armageddon_Sorcerer_Source_Tree.json" LogicalName="ArmageddonSorcererSourceTree" />
		<EmbeddedResource Include="../Design Documents/Magic/Armageddon_Seeder_Completeness_Design_20261011.json" LogicalName="ArmageddonStockDesign" />
		<EmbeddedResource Include="Assets/Manifests/Armageddon/*.json" LogicalName="DatabaseSeeder.Armageddon.%(Filename)%(Extension)" />
		<EmbeddedResource Include="Assets/Manifests/Armageddon/*.tsv" LogicalName="DatabaseSeeder.Armageddon.%(Filename)%(Extension)" />
	</ItemGroup>
	<Import Project="../SeederFramework/SeederPublishing.targets" />
</Project>
