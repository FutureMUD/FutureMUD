<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>Exe</OutputType>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<Version>3.5.1</Version>
	<AssemblyVersion>3.5.1</AssemblyVersion>
	<FileVersion>3.5.1</FileVersion>
  </PropertyGroup>

	<PropertyGroup>
		<RollForward>Major</RollForward>
	</PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	<GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
  </PropertyGroup>

    <ItemGroup>
	<EmbeddedResource Include="Seeders\CultureSeeder\CultureToolkit\ReviewedSourceProse.json" LogicalName="CultureReviewedProse" />
	<PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
	<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.11" />
	<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
	<PackageReference Include="TimeZoneConverter" Version="7.2.0" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\FutureMUDLibrary\FutureMUDLibrary.csproj" />
	<ProjectReference Include="..\MudsharpDatabaseLibrary\MudsharpDatabaseLibrary.csproj" />
	<ProjectReference Include="..\MudSharpCore\MudSharpCore.csproj" Aliases="EngineCompiler" />
  </ItemGroup>

  <ItemGroup>
	<Content Include="Assets\Database\BlankDatabaseSnapshot.sql">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	</Content>
	<Content Include="Assets\Database\BlankDatabaseSnapshot.manifest.json">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	</Content>
	<Content Include="..\Design Documents\Seeding\Seeded_Item_Manifest.json" Link="Assets\Manifests\Seeded_Item_Manifest.json">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	</Content>
	<EmbeddedResource Include="Seeders\ItemSeeder\FoodCatalogue\**\*.tsv">
		<LogicalName>DatabaseSeeder.Seeders.FoodCatalogue.$([System.String]::Copy('%(RecursiveDir)').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)</LogicalName>
	</EmbeddedResource>
	<EmbeddedResource Include="Seeders\ItemSeeder\MedicalRepairCatalogue\**\*.tsv">
		<LogicalName>DatabaseSeeder.Seeders.MedicalRepairCatalogue.$([System.String]::Copy('%(RecursiveDir)').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)</LogicalName>
	</EmbeddedResource>
	<EmbeddedResource Include="..\Design Documents\Seeding\CultureSeederRedesignHandoff\data\*.json">
		<LogicalName>CultureToolkit.data.%(Filename)%(Extension)</LogicalName>
	</EmbeddedResource>
	<EmbeddedResource Include="..\Design Documents\Seeding\CultureSeederRedesignHandoff\research\*.json">
		<LogicalName>CultureToolkit.research.%(Filename)%(Extension)</LogicalName>
	</EmbeddedResource>
	<EmbeddedResource Include="Seeders\IndustrialisedCatalogue\**\*.tsv" />
	<EmbeddedResource Include="..\Design Documents\Data\Item_Component_Types.json" Link="IndustrialisedCatalogue\Item_Component_Types.json" />
	<EmbeddedResource Include="..\Design Documents\Data\Seeded_Item_Components.json" Link="IndustrialisedCatalogue\Seeded_Item_Components.json" />
  </ItemGroup>

</Project>
