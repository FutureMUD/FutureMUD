  "stage": "1C: attribute-led capacity, invalidation and provisional energy affordability",
  "status": "implemented_and_verified_parent_independent_review_pending",
  "base_commit": "43d7fa7ba75d5f9dc41ccadcf5d29a8d8d495e39",
  "implementation_head": "2972922b7212934b4bfd46cea39c14fab6e46924",
  "branch": "codex/armageddon-completion-phase1",
  "changed_files": 41,
  "implemented": [
    "Optional explicitly configured native body attribute, named trait expression and raw/effective basis; versioned XML, builders and clone compatibility.",
    "Pure strict attribute-only evaluation with finite nonnegative maxima; configured-invalid XML/expression fails closed without falling back to legacy cap Progs.",
    "Canonical reserve owner current-body capacity, valid downward clamping, no refill on rises/enrolment/route/focus changes; invalid maxima/balances retain recoverable values and refuse accounting.",
    "Read-only affordability bounded by both actual balance and current maximum; live casts reconcile before preparation/payment/progression.",
    "Standard raw/effective invalidation for attributes, bonus/suppression effects, merits, inventory/implants, power/health/revisions, labour, racial bonuses and mapped expression edits.",
    "Nested restoration scopes defer clamping during successful character/effect reconstruction and body transitions; incomplete restoration cannot spend or receive configured reserve energy.",
    "Exact 82-spell source energy envelopes across 28 normal and six next-grade Overreach pairs, three native capacities and two explicitly provisional profiles."
  ],
  "review_and_failure_repairs": [
    {
      "finding": "Effective trait penalties did not invalidate a configured reserve.",
      "repair": "Notify bonus/suppression changes and validate current capacity at accounting boundaries; clamp decreases without refilling after removal."
    },
    {
      "finding": "Backup-body activation lacked capacity reconciliation.",
      "repair": "Add reconciliation after successful activation, with restoration deferral across the transition."
    },
    {
      "finding": "A configured negative balance could receive an ordinary credit.",
      "repair": "Preserve invalid balances while refusing ordinary credits/debits/casts until repaired."
    },
    {
      "finding": "Persisted balances could clamp before saved positive bonuses or a complete effect list restored.",
      "repair": "Nested production restoration scopes and successful-completion reconciliation; automated regressions and live-service native independent reconstruction."
    },
    {
      "finding": "Full-suite empty-body inventory regression exposed a missing world/actor guard in the new invalidation hook.",
      "repair": "Guard absent world/actor; the existing inventory regression and final full suites pass."
    }
  ],
  "independent_bounded_review": {
    "status": "no_remaining_actionable_defects_after_repairs",
    "scope": "Read-only review of stage1C accounting, capacity invalidation, restoration and compatibility.",
    "limitations": "Code review is not gameplay verification; parent exact-commit review remains pending."
  },
