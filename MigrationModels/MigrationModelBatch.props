<Project>
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<AssemblyName>MudSharp.MigrationModels.$(MSBuildProjectName)</AssemblyName>
		<MigrationModelRole>$(MSBuildProjectName)</MigrationModelRole>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<BuildInParallel>false</BuildInParallel>
		<UseSharedCompilation>false</UseSharedCompilation>
		<IsPackable>false</IsPackable>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
		<PackageReference Include="MySqlConnector" Version="2.6.2" />
		<PackageReference Include="Microting.EntityFrameworkCore.MySql" Version="10.0.14" />
	</ItemGroup>
</Project>
