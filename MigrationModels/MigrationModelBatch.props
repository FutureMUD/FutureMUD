<Project>
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>MudSharp.MigrationModels.$(MSBuildProjectName)</AssemblyName>
		<MigrationModelRole>$(MSBuildProjectName)</MigrationModelRole>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<BuildInParallel>false</BuildInParallel>
		<UseSharedCompilation>false</UseSharedCompilation>
		<IsPackable>false</IsPackable>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.21" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.21" />
		<PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
	</ItemGroup>
</Project>
