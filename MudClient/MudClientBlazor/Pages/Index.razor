	private async Task SendLoginAliasAsync()
	{
		try
		{
			if (!CanSendLoginAlias)
			{
				return;
			}

			foreach (var step in LoginAliasCommandSequence.Build(CurrentQuickAliasSettings.Login))
			{
				await SendSingleCommandAsync(
					step.Command,
					step.EchoCommand,
					step.LogCommandText,
					step.AddToHistory);

				if (step.DelayAfterCommand)
				{
					await Task.Delay(LoginAliasStepDelay);
				}
			}
		}
		finally
		{
			await FocusCommandInputAsync();
		}
	}

