	private static bool IsModifierKey(string? keyCode)
	{
		return keyCode is "ShiftLeft" or "ShiftRight" or "ControlLeft" or "ControlRight" or
			"AltLeft" or "AltRight" or "MetaLeft" or "MetaRight";
	}

