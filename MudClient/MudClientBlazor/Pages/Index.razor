	private void CaptureHotkeyKey(HotkeyBinding binding, KeyboardEventArgs args)
	{
		if (IsModifierKey(args.Code))
		{
			return;
		}

		if (args.CtrlKey || args.AltKey || args.MetaKey || args.ShiftKey)
		{
			HotkeySettingsError = "Hotkeys use unmodified keys only.";
			return;
		}

		if (string.IsNullOrWhiteSpace(args.Code))
		{
			return;
		}

		binding.KeyCode = args.Code;
		binding.KeyDisplay = HotkeyKeyFormatter.Format(args.Code, args.Key);
		HotkeySettingsError = null;
		ValidateHotkeyDraft();
	}

