	private IEnumerable<HotkeyBinding> GetOrderedActiveHotkeyBindings(
		IReadOnlyDictionary<string, int> sortOrder,
		bool includeNoOpButtons = true)
	{
		return CurrentHotkeySettings.Bindings
			.Where(binding =>
				binding.IsEnabled &&
				!string.IsNullOrWhiteSpace(binding.Label) &&
				(includeNoOpButtons || !string.IsNullOrWhiteSpace(binding.Command)))
			.OrderBy(binding => sortOrder.TryGetValue(binding.Id, out var index) ? index : int.MaxValue)
			.ThenBy(binding => binding.Label, StringComparer.OrdinalIgnoreCase);
	}

