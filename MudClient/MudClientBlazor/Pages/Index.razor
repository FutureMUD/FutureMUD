@page "/"
@inject NavigationManager NavigationManager
@using System.Net.WebSockets
@using System.Text
@using System.Text.Json
@using MudClientBlazor.Services
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable
@inject ILogger<Index> Logger
@inject IConfiguration Configuration

<div class="app-root" style="@GetClientStyle()">
	<div class="app-grid">
		<div class="play-surface">
			<div class="message-container" @ref="MessageContainer">
				@foreach (var message in Messages)
				{
					<div>@(new MarkupString(message))</div>
				}
			</div>

			<aside class="hotkey-panel" aria-label="Hotkey commands">
				<div class="hotkey-panel-title">Hotkeys</div>
				<div class="hotkey-pad">
					@foreach (var binding in DesktopHotkeyBindings)
					{
						<button type="button"
								class="@GetHotkeyButtonClass(binding)"
								disabled="@(!CanSendHotkeyBinding(binding))"
								title="@GetHotkeyTitle(binding)"
								@onclick="() => SendHotkeyBindingAsync(binding)">
							<span class="hotkey-button-label">@GetHotkeyPadLabel(binding)</span>
							<span class="hotkey-button-key">@GetHotkeyKeyLabel(binding)</span>
						</button>
					}
				</div>
				<div class="quick-alias-panel" aria-label="Quick aliases">
					<button type="button"
							class="@GetLoginAliasButtonClass()"
							disabled="@(!CanSendLoginAlias)"
							title="@GetLoginAliasTitle()"
							@onclick="SendLoginAliasAsync">
						<span class="quick-alias-label">@CurrentQuickAliasSettings.Login.Label</span>
					</button>
					<div class="quick-alias-grid">
						@foreach (var alias in DesktopQuickAliases)
						{
							<button type="button"
									class="@GetQuickAliasButtonClass(alias)"
									disabled="@(!CanSendQuickAlias(alias))"
									title="@GetQuickAliasTitle(alias)"
									@onclick="() => SendQuickAliasAsync(alias)">
								<span class="quick-alias-label">@alias.Label</span>
							</button>
						}
					</div>
				</div>
			</aside>
		</div>

		<div class="hotkey-strip" aria-label="Hotkey commands">
			@foreach (var binding in MobileHotkeyBindings)
			{
				<button type="button"
						class="hotkey-button"
						title="@GetHotkeyTitle(binding)"
						@onclick="() => SendHotkeyBindingAsync(binding)">
					<span class="hotkey-button-label">@binding.Label</span>
					<span class="hotkey-button-key">@GetHotkeyKeyLabel(binding)</span>
				</button>
			}
		</div>

		<div class="input-container">
			<label for="userInput" class="visually-hidden">Command Input</label>
			<textarea id="userInput"
					  @bind="UserInput"
					  @bind:event="oninput"
					  @onkeydown="HandleKeyDown"
					  @onkeydown:preventDefault="true"
					  class="input-field"
					  placeholder="Type a command..."
					  autocomplete="off">
			</textarea>
		</div>

		@if (_hotkeySettingsOpen)
		{
			<section class="settings-panel" aria-label="Client settings" data-hotkey-settings="true">
				<div class="settings-panel-header">
					<div>
						<h2>Settings</h2>
						<p>Display, input, command stacking, aliases, and hotkey preferences are saved in this browser.</p>
					</div>
					<div class="settings-actions">
						<button type="button" class="client-button secondary-button" @onclick="ResetHotkeyDraft">Reset</button>
						<button type="button" class="client-button secondary-button" @onclick="CancelHotkeySettingsAsync">Cancel</button>
						<button type="button" class="client-button primary-button" disabled="@(!CanSaveHotkeySettings)" @onclick="SaveHotkeySettingsAsync">Save</button>
					</div>
				</div>

				@if (!string.IsNullOrWhiteSpace(HotkeySettingsError) || HotkeyDraftErrors.Count > 0 || ClientSettingsDraftErrors.Count > 0)
				{
					<div class="settings-error" role="alert">
						@if (!string.IsNullOrWhiteSpace(HotkeySettingsError))
						{
							<div>@HotkeySettingsError</div>
						}
						@foreach (var error in HotkeyDraftErrors)
						{
							<div>@error</div>
						}
						@foreach (var error in ClientSettingsDraftErrors)
						{
							<div>@error</div>
						}
					</div>
				}

				<div class="settings-section">
					<h3>Display</h3>
					<div class="client-settings-grid">
						<label>
							<span>Font</span>
							<select class="settings-input" value="@ClientSettingsDraft.FontFamily" @onchange="args => UpdateClientFontFamily(args.Value?.ToString())" aria-label="Client font">
								@foreach (var font in ClientSettings.FontOptions)
								{
									<option value="@font.CssValue">@font.Label</option>
								}
							</select>
						</label>
						<label>
							<span>Font size (px)</span>
							<input class="settings-input" type="number" min="8" max="32" step="1" value="@ClientSettingsDraft.FontSizePx" @oninput="args => UpdateClientFontSize(args.Value?.ToString())" aria-label="Font size in pixels" />
						</label>
						<label>
							<span>Window width (px)</span>
							<input class="settings-input" type="number" min="1000" max="5000" step="50" value="@ClientSettingsDraft.AppWidthPx" @oninput="args => UpdateAppWidth(args.Value?.ToString())" aria-label="Client window width in pixels" />
							<small>Controls the maximum width on larger screens.</small>
						</label>
						<label>
							<span>Wrap width (px)</span>
							<input class="settings-input" type="number" min="0" max="3000" step="10" value="@ClientSettingsDraft.MessageWrapWidthPx" @oninput="args => UpdateMessageWrapWidth(args.Value?.ToString())" aria-label="Manual message wrap width in pixels" />
							<small>0 uses the available width.</small>
						</label>
						<label>
							<span>Left offset (px)</span>
							<input class="settings-input" type="number" min="0" max="500" step="1" value="@ClientSettingsDraft.MessageLeftOffsetPx" @oninput="args => UpdateMessageLeftOffset(args.Value?.ToString())" aria-label="Message left offset in pixels" />
						</label>
						<label>
							<span>Line height</span>
							<input class="settings-input" type="number" min="1" max="3" step="0.05" value="@ClientSettingsDraft.MessageLineHeight" @oninput="args => UpdateMessageLineHeight(args.Value?.ToString())" aria-label="Message line height" />
						</label>
						<label>
							<span>Message gap (px)</span>
							<input class="settings-input" type="number" min="0" max="100" step="1" value="@ClientSettingsDraft.MessageSpacingPx" @oninput="args => UpdateMessageSpacing(args.Value?.ToString())" aria-label="Message spacing in pixels" />
						</label>
					</div>
				</div>

				<div class="settings-section">
					<h3>Input and command stacking</h3>
					<div class="client-settings-grid">
						<label class="settings-checkbox">
							<input type="checkbox" checked="@ClientSettingsDraft.ClearInputAfterSend" @onchange="args => UpdateClearInputAfterSend(args.Value)" />
							<span>Clear input after sending</span>
						</label>
						<label class="settings-checkbox">
							<input type="checkbox" checked="@ClientSettingsDraft.SemicolonCommandStackingEnabled" @onchange="args => UpdateSemicolonCommandStacking(args.Value)" />
							<span>Split stacked commands</span>
						</label>
						<label>
							<span>Stacking character</span>
							<input class="settings-input" maxlength="1" value="@ClientSettingsDraft.CommandStackingDelimiter" @oninput="args => UpdateCommandStackingDelimiter(args.Value?.ToString())" aria-label="Command stacking character" />
							<small>Use \; to send the character literally.</small>
						</label>
						<label class="settings-checkbox">
							<input type="checkbox" checked="@ClientSettingsDraft.NewlineCommandStackingEnabled" @onchange="args => UpdateNewlineCommandStacking(args.Value)" />
							<span>Split pasted new lines into commands</span>
						</label>
					</div>
				</div>

				<div class="settings-section">
					<h3>Quick Login</h3>
					<div class="login-settings-grid">
						<label>
							<span>Initial Command</span>
							<input class="settings-input"
								   value="@QuickAliasDraft.Login.InitialCommand"
								   @oninput="args => UpdateLoginInitialCommand(args.Value?.ToString())"
								   aria-label="Login initial command" />
						</label>
						<label>
							<span>Username</span>
							<input class="settings-input"
								   value="@QuickAliasDraft.Login.Username"
								   @oninput="args => UpdateLoginUsername(args.Value?.ToString())"
								   aria-label="Login username" />
						</label>
						<label>
							<span>Password</span>
							<input class="settings-input"
								   type="password"
								   autocomplete="current-password"
								   value="@QuickAliasDraft.Login.Password"
								   @oninput="args => UpdateLoginPassword(args.Value?.ToString())"
								   aria-label="Login password" />
						</label>
					</div>
				</div>

				<div class="settings-section">
					<h3>Quick Aliases</h3>
					<div class="alias-settings-grid" role="table" aria-label="Quick alias map">
						<div class="alias-settings-grid-row settings-grid-header" role="row">
							<div role="columnheader">On</div>
							<div role="columnheader">Button</div>
							<div role="columnheader">Text</div>
						</div>
						@foreach (var alias in QuickAliasDraft.Aliases)
						{
							<div class="alias-settings-grid-row" role="row" @key="alias.Id">
								<label class="toggle-cell" role="cell">
									<input type="checkbox"
										   checked="@alias.IsEnabled"
										   @onchange="args => UpdateAliasEnabled(alias, args.Value)" />
									<span class="visually-hidden">Enable @alias.Label</span>
								</label>
								<div role="cell">
									<input class="settings-input"
										   value="@alias.Label"
										   @oninput="args => UpdateAliasLabel(alias, args.Value?.ToString())"
										   aria-label="Alias button label" />
								</div>
								<div role="cell">
									<input class="settings-input command-input"
										   value="@alias.Command"
										   @oninput="args => UpdateAliasCommand(alias, args.Value?.ToString())"
										   aria-label="@($"Text for {alias.Label}")" />
								</div>
							</div>
						}
					</div>
				</div>

				<div class="settings-section">
					<h3>Numpad</h3>
					<div class="settings-grid" role="table" aria-label="Hotkey binding map">
						<div class="settings-grid-row settings-grid-header" role="row">
							<div role="columnheader">On</div>
							<div role="columnheader">Button</div>
							<div role="columnheader">Key</div>
							<div role="columnheader">Command</div>
							<div role="columnheader">Clear</div>
						</div>
						@foreach (var binding in HotkeyDraft)
						{
							<div class="settings-grid-row" role="row" @key="binding.Id">
								<label class="toggle-cell" role="cell">
									<input type="checkbox"
										   checked="@binding.IsEnabled"
										   @onchange="args => UpdateDraftEnabled(binding, args.Value)" />
									<span class="visually-hidden">Enable @binding.Label</span>
								</label>
								<div role="cell">
									<input class="settings-input"
										   value="@binding.Label"
										   @oninput="args => UpdateDraftLabel(binding, args.Value?.ToString())"
										   aria-label="Button label" />
								</div>
								<div role="cell">
									<input class="settings-input key-input"
										   value="@binding.KeyDisplay"
										   readonly
										   placeholder="Press a key"
										   @onkeydown="args => CaptureHotkeyKey(binding, args)"
										   @onkeydown:preventDefault="true"
										   @onkeydown:stopPropagation="true"
										   aria-label="@($"Key for {binding.Label}")" />
								</div>
								<div role="cell">
									<input class="settings-input command-input"
										   value="@binding.Command"
										   @oninput="args => UpdateDraftCommand(binding, args.Value?.ToString())"
										   aria-label="@($"Command for {binding.Label}")" />
								</div>
								<div role="cell">
									<button type="button"
											class="client-button compact-button"
											@onclick="() => ClearDraftKey(binding)"
											aria-label="@($"Clear key for {binding.Label}")">
										Clear
									</button>
								</div>
							</div>
						}
					</div>
				</div>
			</section>
		}
		
		<div class="status-footer">
			<div class="connection-status" aria-live="polite">
				<span class="connection-dot @(isConnected ? "is-connected" : "is-disconnected")" aria-hidden="true"></span>
				<span>@(isConnected ? "Connected" : "Disconnected")</span>
			</div>

			<div class="button-container">
				<button type="button" class="client-button primary-button" @onclick="ToggleConnection">@connectionButtonText</button>
				<button type="button" class="client-button secondary-button" @onclick="SaveLog">Save Log</button>
				<button type="button" class="client-button secondary-button" @onclick="ToggleHotkeySettings">Settings</button>
			</div>
		</div>
	</div>
</div>

@code {
	private const string HotkeyStorageKey = "MudClientBlazor.HotkeySettings.v1";
	private const string QuickAliasStorageKey = "MudClientBlazor.QuickAliasSettings.v1";
	private const string ClientSettingsStorageKey = "MudClientBlazor.ClientSettings.v1";
	private static readonly TimeSpan LoginAliasStepDelay = TimeSpan.FromMilliseconds(750);
	private static readonly TimeSpan StackedCommandDelay = TimeSpan.FromMilliseconds(750);
	private static readonly JsonSerializerOptions HotkeyJsonOptions = new(JsonSerializerDefaults.Web)
	{
		WriteIndented = true
	};
	private static readonly IReadOnlyDictionary<string, int> DesktopHotkeySortOrder = BuildSortOrder(
	[
		"enter",
		"leave",
		"up",
		"northwest",
		"north",
		"northeast",
		"down",
		"west",
		"numpad5",
		"east",
		"southwest",
		"south",
		"southeast",
		"numpad-enter",
		"look",
		"score"
	]);
	private static readonly IReadOnlyDictionary<string, int> MobileHotkeySortOrder = BuildSortOrder(
	[
		"north",
		"east",
		"south",
		"west",
		"numpad5",
		"look",
		"numpad-enter",
		"enter",
		"leave",
		"up",
		"down",
		"score",
		"northwest",
		"northeast",
		"southeast",
		"southwest"
	]);
	private static readonly IReadOnlyDictionary<string, string> DefaultHotkeyLabels =
		HotkeySettings.CreateDefaultBindings().ToDictionary(binding => binding.Id, binding => binding.Label);
	private static readonly IReadOnlyDictionary<string, string> CompactHotkeyLabels =
		new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
		{
			["northwest"] = "NW",
			["north"] = "N",
			["northeast"] = "NE",
			["west"] = "W",
			["east"] = "E",
			["southwest"] = "SW",
			["south"] = "S",
			["southeast"] = "SE",
			["enter"] = "In",
			["leave"] = "Out",
			["down"] = "Dn",
			["numpad5"] = "5",
			["numpad-enter"] = "Key"
		};

	private string UserInput { get; set; } = string.Empty;
	private List<string> Messages { get; set; } = new List<string>();
	private ClientWebSocket? _clientWebSocket;
	private CancellationTokenSource _cancellationTokenSource = new CancellationTokenSource();
	private ElementReference MessageContainer;
	private List<string> CommandHistory { get; set; } = new List<string>();
	private int CommandHistoryIndex { get; set; } = -1;
	private AnsiMxpParser _ansiMxpParser = new AnsiMxpParser();
	private Uri? _webSocketEndpoint;
	private HotkeySettings CurrentHotkeySettings { get; set; } = HotkeySettings.CreateDefault();
	private HotkeyBindingMap HotkeyMap { get; set; } = HotkeyBindingMap.Create(HotkeySettings.CreateDefault().Bindings);
	private List<HotkeyBinding> HotkeyDraft { get; set; } = new();
	private QuickAliasSettings CurrentQuickAliasSettings { get; set; } = QuickAliasSettings.CreateDefault();
	private QuickAliasSettings QuickAliasDraft { get; set; } = QuickAliasSettings.CreateDefault();
	private ClientSettings CurrentClientSettings { get; set; } = ClientSettings.CreateDefault();
	private ClientSettings ClientSettingsDraft { get; set; } = ClientSettings.CreateDefault();
	private IReadOnlyList<string> HotkeyDraftErrors { get; set; } = [];
	private IReadOnlyList<string> ClientSettingsDraftErrors { get; set; } = [];
	private string? HotkeySettingsError { get; set; }
	private bool _hotkeySettingsOpen;


	// Declare the object reference
	private DotNetObjectReference<Index>? _objectReference;

	// Ensure disposal to prevent memory leaks
	public void Dispose()
	{
		_objectReference?.Dispose();
	}

	protected override async Task OnInitializedAsync()
	{
		// Create the object reference
		_objectReference = DotNetObjectReference.Create(this);

		// Pass the object reference to JavaScript
		await JSRuntime.InvokeVoidAsync("registerSendCommandHandler", _objectReference);
		await JSRuntime.InvokeVoidAsync("mudClientHotkeys.register", _objectReference);
		await LoadClientSettingsAsync();
		await LoadHotkeySettingsAsync();
		await LoadQuickAliasSettingsAsync();
		
		try
		{
			_webSocketEndpoint = WebSocketEndpoint.FromConfiguration(Configuration, NavigationManager.ToAbsoluteUri("/"));
		}
		catch (Exception ex)
		{
			Messages.Add($"Client configuration error: {EscapeHtml(GetDetailedExceptionMessage(ex))}");
			isConnected = false;
			return;
		}

		// Connect to the local WebSocket proxy. The proxy then connects to the telnet MUD server.
		await ConnectToWebSocketAsync(_webSocketEndpoint);
	}

	private IEnumerable<HotkeyBinding> DesktopHotkeyBindings => GetOrderedActiveHotkeyBindings(DesktopHotkeySortOrder);

	private IEnumerable<HotkeyBinding> MobileHotkeyBindings => GetOrderedActiveHotkeyBindings(MobileHotkeySortOrder, includeNoOpButtons: false);

	private IEnumerable<QuickAliasBinding> DesktopQuickAliases => CurrentQuickAliasSettings.Aliases
		.Where(alias => alias.IsEnabled && !string.IsNullOrWhiteSpace(alias.Label));

	private bool CanSendLoginAlias => CurrentQuickAliasSettings.Login.IsEnabled &&
		(!string.IsNullOrWhiteSpace(CurrentQuickAliasSettings.Login.InitialCommand) ||
		 !string.IsNullOrWhiteSpace(CurrentQuickAliasSettings.Login.Username) ||
		 !string.IsNullOrEmpty(CurrentQuickAliasSettings.Login.Password));

	private bool CanSaveHotkeySettings => HotkeyDraftErrors.Count == 0 && ClientSettingsDraftErrors.Count == 0;

	private string GetClientStyle()
	{
		var settings = CurrentClientSettings;
		var wrapWidth = settings.MessageWrapWidthPx > 0 ? $"{settings.MessageWrapWidthPx}px" : "none";
		return $"--client-app-width:{settings.AppWidthPx}px;--client-font-family:{settings.FontFamily};--client-font-size:{settings.FontSizePx}px;--client-message-wrap-width:{wrapWidth};--client-message-left-offset:{settings.MessageLeftOffsetPx}px;--client-message-line-height:{settings.MessageLineHeight.ToString(System.Globalization.CultureInfo.InvariantCulture)};--client-message-spacing:{settings.MessageSpacingPx}px";
	}

	private async Task LoadClientSettingsAsync()
	{
		var settings = ClientSettings.CreateDefault();

		try
		{
			var json = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", ClientSettingsStorageKey);
			if (!string.IsNullOrWhiteSpace(json))
			{
				var savedSettings = JsonSerializer.Deserialize<ClientSettings>(json, HotkeyJsonOptions);
				settings = ClientSettings.Normalize(savedSettings);
			}
		}
		catch (Exception ex)
		{
			Logger.LogWarning(ex, "Unable to load client settings.");
			Messages.Add("Could not load saved client settings; using defaults.");
		}

		ApplyClientSettings(settings);
	}

	private async Task LoadHotkeySettingsAsync()
	{
		var settings = HotkeySettings.CreateDefault();

		try
		{
			var json = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", HotkeyStorageKey);
			if (!string.IsNullOrWhiteSpace(json))
			{
				var savedSettings = JsonSerializer.Deserialize<HotkeySettings>(json, HotkeyJsonOptions);
				settings = HotkeySettings.Normalize(savedSettings);
			}
		}
		catch (Exception ex)
		{
			Logger.LogWarning(ex, "Unable to load hotkey settings.");
			Messages.Add("Could not load saved hotkey settings; using defaults.");
		}

		ApplyHotkeySettings(settings);
		await UpdateBrowserHotkeyBindingsAsync();
	}

	private async Task LoadQuickAliasSettingsAsync()
	{
		var settings = QuickAliasSettings.CreateDefault();

		try
		{
			var json = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", QuickAliasStorageKey);
			if (!string.IsNullOrWhiteSpace(json))
			{
				var savedSettings = JsonSerializer.Deserialize<QuickAliasSettings>(json, HotkeyJsonOptions);
				settings = QuickAliasSettings.Normalize(savedSettings);
			}
		}
		catch (Exception ex)
		{
			Logger.LogWarning(ex, "Unable to load quick alias settings.");
			Messages.Add("Could not load saved quick alias settings; using defaults.");
		}

		ApplyQuickAliasSettings(settings);
	}

	private async Task ToggleHotkeySettings()
	{
		if (_hotkeySettingsOpen)
		{
			await CancelHotkeySettingsAsync();
			return;
		}

		HotkeyDraft = CurrentHotkeySettings.Bindings.Select(binding => binding.Clone()).ToList();
		QuickAliasDraft = CurrentQuickAliasSettings.Clone();
		ClientSettingsDraft = CurrentClientSettings.Clone();
		HotkeySettingsError = null;
		ValidateHotkeyDraft();
		ValidateClientSettingsDraft();
		_hotkeySettingsOpen = true;
		await SetBrowserHotkeyCaptureEnabledAsync(false);
	}

	private async Task CancelHotkeySettingsAsync()
	{
		_hotkeySettingsOpen = false;
		HotkeySettingsError = null;
		await SetBrowserHotkeyCaptureEnabledAsync(true);
	}

	private async Task SaveHotkeySettingsAsync()
	{
		ValidateHotkeyDraft();
		ValidateClientSettingsDraft();
		if (!CanSaveHotkeySettings)
		{
			return;
		}

		var settings = HotkeySettings.Normalize(new HotkeySettings
		{
			Bindings = HotkeyDraft.Select(binding => binding.Clone()).ToList()
		});
		var quickAliasSettings = QuickAliasSettings.Normalize(QuickAliasDraft);
		var clientSettings = ClientSettings.Normalize(ClientSettingsDraft);

		try
		{
			var json = JsonSerializer.Serialize(settings, HotkeyJsonOptions);
			await JSRuntime.InvokeVoidAsync("localStorage.setItem", HotkeyStorageKey, json);
			var quickAliasJson = JsonSerializer.Serialize(quickAliasSettings, HotkeyJsonOptions);
			await JSRuntime.InvokeVoidAsync("localStorage.setItem", QuickAliasStorageKey, quickAliasJson);
			var clientSettingsJson = JsonSerializer.Serialize(clientSettings, HotkeyJsonOptions);
			await JSRuntime.InvokeVoidAsync("localStorage.setItem", ClientSettingsStorageKey, clientSettingsJson);
		}
		catch (Exception ex)
		{
			Logger.LogWarning(ex, "Unable to save command settings.");
			HotkeySettingsError = "Could not save command settings in this browser.";
			return;
		}

		ApplyHotkeySettings(settings);
		ApplyQuickAliasSettings(quickAliasSettings);
		ApplyClientSettings(clientSettings);
		_hotkeySettingsOpen = false;
		HotkeySettingsError = null;
		await UpdateBrowserHotkeyBindingsAsync();
		await SetBrowserHotkeyCaptureEnabledAsync(true);
	}

	private void ResetHotkeyDraft()
	{
		HotkeyDraft = HotkeySettings.CreateDefault().Bindings.Select(binding => binding.Clone()).ToList();
		QuickAliasDraft = QuickAliasSettings.CreateDefault();
		ClientSettingsDraft = ClientSettings.CreateDefault();
		HotkeySettingsError = null;
		ValidateHotkeyDraft();
		ValidateClientSettingsDraft();
	}

	private void ApplyHotkeySettings(HotkeySettings settings)
	{
		CurrentHotkeySettings = HotkeySettings.Normalize(settings);
		HotkeyMap = HotkeyBindingMap.Create(CurrentHotkeySettings.Bindings);
	}

	private void ApplyQuickAliasSettings(QuickAliasSettings settings)
	{
		CurrentQuickAliasSettings = QuickAliasSettings.Normalize(settings);
	}

	private void ApplyClientSettings(ClientSettings settings)
	{
		CurrentClientSettings = ClientSettings.Normalize(settings);
	}

	private void ValidateClientSettingsDraft()
	{
		ClientSettingsDraftErrors = ClientSettingsValidator.Validate(ClientSettingsDraft);
	}

	private void UpdateClientFontFamily(string? value)
	{
		ClientSettingsDraft.FontFamily = value ?? ClientSettings.DefaultFontFamily;
		ValidateClientSettingsDraft();
	}

	private void UpdateClientFontSize(string? value)
	{
		if (int.TryParse(value, out var parsed))
		{
			ClientSettingsDraft.FontSizePx = parsed;
		}

		ValidateClientSettingsDraft();
	}

	private void UpdateAppWidth(string? value)
	{
		if (int.TryParse(value, out var parsed))
		{
			ClientSettingsDraft.AppWidthPx = parsed;
		}

		ValidateClientSettingsDraft();
