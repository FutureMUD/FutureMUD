<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MudSharp</RootNamespace>
    <MigrationModelRole>forwarders</MigrationModelRole>
    <BuildInParallel>false</BuildInParallel>
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Proxies" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageReference Include="MySql.Data" Version="26.10.0" />
    <PackageReference Include="MySqlBackup.NET" Version="2.7.1" />
	<PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Microting.EntityFrameworkCore.MySql" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Migrations/**/*.Designer.cs" />
    <ProjectReference Include="../MigrationModels/Batch*/*.csproj" />
  </ItemGroup>
  <Import Project="../MigrationModels/MigrationModelGeneration.targets" />
</Project>
