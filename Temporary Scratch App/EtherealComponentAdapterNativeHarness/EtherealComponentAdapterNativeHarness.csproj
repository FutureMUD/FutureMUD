<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>FutureMUD.GatheringNativePersistenceHarness.EtherealComponentAdapterEntry</StartupObject>
    <AssemblyName>GatheringNativePersistenceHarness</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../GatheringNativePersistenceHarness/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <Compile Include="../FiveStockNativeHarness/Program.*.cs" Link="FiveStock/%(Filename)%(Extension)" />
    <Compile Include="../ProvisionStockNativeHarness/Program.*.cs" Link="ProvisionStock/%(Filename)%(Extension)" />
    <Compile Include="../PierceStockNativeHarness/Program.*.cs" Link="PierceStock/%(Filename)%(Extension)" />
    <Compile Include="../WaterBreathingAdapterNativeHarness/Program.WaterBreathingAdapter.cs" Link="WaterAdapter/Program.WaterBreathingAdapter.cs" />
    <Compile Include="../EtherealAdapterNativeHarness/Program.EtherealAdapter.cs" Link="EtherealAdapter/Program.EtherealAdapter.cs" />
    <Compile Include="../WaterBreathingStockNativeHarness/Program.WaterBreathingStock.cs" Link="WaterStock/Program.WaterBreathingStock.cs" />
    <ProjectReference Include="../../FutureMUDLibrary/FutureMUDLibrary.csproj" />
    <ProjectReference Include="../../MudsharpDatabaseLibrary/MudsharpDatabaseLibrary.csproj" />
    <ProjectReference Include="../../MudSharpCore/MudSharpCore.csproj" />
    <PackageReference Include="Moq" Version="4.20.70" />
  </ItemGroup>
</Project>
