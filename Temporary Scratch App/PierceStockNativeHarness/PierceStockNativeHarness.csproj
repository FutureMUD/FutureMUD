<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>FutureMUD.GatheringNativePersistenceHarness.PierceStockEntry</StartupObject>
    <AssemblyName>GatheringNativePersistenceHarness</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../GatheringNativePersistenceHarness/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <Compile Include="../FiveStockNativeHarness/Program.*.cs" Link="FiveStock/%(Filename)%(Extension)" />
    <Compile Include="../ProvisionStockNativeHarness/Program.*.cs" Link="ProvisionStock/%(Filename)%(Extension)" />
    <ProjectReference Include="../../FutureMUDLibrary/FutureMUDLibrary.csproj" />
    <ProjectReference Include="../../MudsharpDatabaseLibrary/MudsharpDatabaseLibrary.csproj" />
    <ProjectReference Include="../../MudSharpCore/MudSharpCore.csproj" />
    <PackageReference Include="Moq" Version="4.20.70" />
  </ItemGroup>
</Project>
