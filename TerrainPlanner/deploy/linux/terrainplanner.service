[Unit]
Description=FutureMUD Terrain Planner and Engine API
After=network-online.target mysql.service mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=terrainplanner
Group=terrainplanner
WorkingDirectory=/opt/futuremud/terrainplanner/current/app
ExecStart=/opt/futuremud/terrainplanner/current/app/TerrainPlanner
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_NOLOGO=1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/futuremud/terrainplanner /var/lib/futuremud/terrainplanner
CapabilityBoundingSet=
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
