<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="FakeDotnet/**/*.cs" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
		<PackageReference Include="MSTest.TestAdapter" Version="2.2.10" />
		<PackageReference Include="MSTest.TestFramework" Version="2.2.10" />
		<ProjectReference Include="../TestReporting/TestReporting.csproj" />
		<ProjectReference Include="FakeDotnet/FakeDotnet.csproj" ReferenceOutputAssembly="false" />
		<None Include="Fixtures/*.trx" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
