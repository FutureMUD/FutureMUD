<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="FakeDotnet/**/*.cs" />
		<Compile Remove="FakeGit/**/*.cs" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
		<PackageReference Include="MSTest.TestAdapter" Version="4.5.3" />
		<PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
		<ProjectReference Include="../TestReporting/TestReporting.csproj" />
		<ProjectReference Include="FakeDotnet/FakeDotnet.csproj" ReferenceOutputAssembly="false" />
		<ProjectReference Include="FakeGit/FakeGit.csproj" ReferenceOutputAssembly="false" />
		<None Include="Fixtures/*.trx" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
