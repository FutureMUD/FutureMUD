    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GatheringNativePersistenceHarness</AssemblyName>
    <StartupObject>FutureMUD.GatheringNativePersistenceHarness.ChargedDeviceEntryPoint</StartupObject>
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\FutureMUDLibrary\FutureMUDLibrary.csproj" />
    <ProjectReference Include="..\..\MudsharpDatabaseLibrary\MudsharpDatabaseLibrary.csproj" />
    <ProjectReference Include="..\..\MudSharpCore\MudSharpCore.csproj" />
    <Compile Include="..\..\Temporary Scratch App\GatheringNativePersistenceHarness\*.cs" Link="BaselineSubstrate\%(Filename)%(Extension)" />
    <PackageReference Include="Moq" Version="4.20.70" />
  </ItemGroup>
</Project>
