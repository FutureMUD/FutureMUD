<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
		<StartupObject>FutureMUD.GatheringNativePersistenceHarness.PreparedSeederEntryPoint</StartupObject>
		<AssemblyName>GatheringNativePersistenceHarness</AssemblyName>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="../../Temporary Scratch App/GatheringNativePersistenceHarness/*.cs" Link="Shared/%(Filename)%(Extension)" />
		<Compile Include="../ArmageddonInstallerNativeHarness/Program.Installer.cs" Link="Installer/Program.Installer.cs" />
		<Compile Include="../ArmageddonTraditionNativeHarness/*.cs" Link="Traditions/%(Filename)%(Extension)" />
		<ProjectReference Include="../../DatabaseSeeder/DatabaseSeeder.csproj" />
		<ProjectReference Include="../../FutureMUDLibrary/FutureMUDLibrary.csproj" />
		<ProjectReference Include="../../MudsharpDatabaseLibrary/MudsharpDatabaseLibrary.csproj" />
		<ProjectReference Include="../../MudSharpCore/MudSharpCore.csproj" />
		<PackageReference Include="Moq" Version="4.20.70" />
	</ItemGroup>
</Project>
